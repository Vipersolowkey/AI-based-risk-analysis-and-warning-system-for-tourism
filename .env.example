# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real secrets.

# --- TrackAsia (route polyline fallback) ---
TRACKASIA_KEY=
TRACKASIA_BASE=https://maps.track-asia.com

# --- SerpAPI (optional live traffic; without it, city lookup + estimated OSRM routes are used) ---
# Comma-separated list to support key rotation, e.g. "key1,key2"
SERPAPI_KEYS=

# --- Auth (JWT) ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440

# --- Air quality (OpenWeatherMap preferred; Open-Meteo fallback needs no key) ---
# Get a key at https://openweathermap.org/api/air-pollution
OPENWEATHERMAP_API_KEY=

# --- Offline news predictions ---
# Optional JSONL override; the API normally loads baseline predictions, then
# gives PhoBERT predictions priority when data/outputs/predictions.jsonl exists.
NEWS_PREDICTIONS_PATH=
NEWS_RISK_MAX_AGE_DAYS=30

# --- Web Push (VAPID) ---
# Generate with: python scripts/generate_vapid_keys.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=mailto:you@example.com
# Solana receipt verification; must be a devnet endpoint.
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
